{
  "name": "elena-fit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@elena/web",
    "dev:app": "turbo run dev --filter=@elena/app",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.0"
  }
}
